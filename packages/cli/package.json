{
  "name": "gisknife",
  "engines": { "node": ">=22.12.0" },
  "version": "0.1.0",
  "description": "The AI-native GIS Swiss Army Knife — Agent Skill + Dual-Engine CLI (TS + Python uvx) + MCP Apps + A2UI 1.0 + WebMCP.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gisknife": "./dist/index.js",
    "gk": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gisknife/core": "workspace:*",
    "@gisknife/mcp": "workspace:*",
    "@gisknife/picker": "workspace:*",
    "@gisknife/webmcp-bridge": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
